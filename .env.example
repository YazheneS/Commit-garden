# ─────────────────────────────────────────────
# GitHub Garden — environment variable template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── GitHub OAuth Application ──────────────────
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:4000/auth/github/callback

# ── Database ──────────────────────────────────
POSTGRES_DB=commit_garden
POSTGRES_USER=garden
POSTGRES_PASSWORD=local-development-only-change-me
DATABASE_URL=postgresql://garden:local-development-only-change-me@localhost:5432/commit_garden

# ── API Service ───────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Session / JWT signing key (generate with: openssl rand -base64 32)
SESSION_SECRET=replace-with-at-least-32-random-bytes

# ── Web App ───────────────────────────────────
VITE_API_URL=http://localhost:4000
APP_BASE_URL=http://localhost:5173/
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
APP_ALLOWED_RETURN_URLS=commitgarden://oauth

# ── Environment ───────────────────────────────
NODE_ENV=development
