# ─────────────────────────────────────────────
# GitHub Garden — environment variable template
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── GitHub OAuth Application ──────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/commit_garden

# ── API Service ───────────────────────────────
API_PORT=3001
API_HOST=localhost

# Session / JWT signing key (generate with: openssl rand -base64 32)
SESSION_SECRET=

# ── Web App ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Environment ───────────────────────────────
NODE_ENV=development
