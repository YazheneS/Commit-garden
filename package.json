{
  "name": "commit-garden",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "GitHub Garden — a pixel-art ecosystem driven by GitHub coding consistency",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "lint": "eslint .",
